{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider Call Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "phase", "case_id", "attempt", "event", "timestamp"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "event": {
      "type": "string",
      "enum": [
        "ABOUT_TO_SEND",
        "HTTP_SUCCESS",
        "HTTP_ERROR",
        "TIMEOUT",
        "VALIDATION_FAILURE_AFTER_HTTP",
        "CANCELLED_BEFORE_SEND"
      ]
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
    "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
    "safe_error_code": {"type": ["string", "null"]}
  }
}
